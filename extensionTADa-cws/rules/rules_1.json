          "value": "Mozilla/5.0 (PS4; Leanback Shell) Cobalt/26.lts.0-qa; compatible;"
        }
      ]
    },
    "condition": {
      "urlFilter": "||youtube.com/tv*",
      "resourceTypes": ["main_frame", "sub_frame", "xmlhttprequest"]
    }
  }
